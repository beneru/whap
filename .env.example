# Supabase Configuration (Optional for Demo/Preview mode; required for live Supabase Postgres/Storage/Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for Magic Link / OAuth redirects and notification links)
NEXT_PUBLIC_APP_URL=http://localhost:3088

# Optional Email Provider (Resend API key for transactional email notifications)
RESEND_API_KEY=re_your_api_key
NOTIFICATION_FROM_EMAIL=notifications@whap.app
